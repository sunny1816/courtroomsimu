# ── Mock mode (set false in production) ──────────────────────────────────────
LEXA_USE_MOCK_LLM=false

# ── vLLM — local GPU server (highest priority when set) ──────────────────────
# Start with: vllm serve meta-llama/Llama-3.1-8B-Instruct --port 8080
VLLM_BASE_URL=
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── NVIDIA NIM ────────────────────────────────────────────────────────────────
NIM_API_KEY=your_nvidia_nim_api_key
NIM_MODEL=meta/llama-3.1-8b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── OpenRouter (free-tier fallback) ───────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Groq (free-tier fallback) ─────────────────────────────────────────────────
GROQ_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Local storage fallback ────────────────────────────────────────────────────
LEXA_LOCAL_STORE=data/local_store.json

# ── CORS ──────────────────────────────────────────────────────────────────────
LEXA_CORS_ORIGINS=http://localhost:5173

# ── RAG / Retrieval ───────────────────────────────────────────────────────────
# Embedding model name (SentenceTransformer, auto-downloaded on first run)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
