# Backend deployment
NIM_API_KEY=your_nvidia_nim_api_key
NIM_MODEL=meta/llama-3.3-70b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LEXA_USE_MOCK_LLM=false
LEXA_LOCAL_STORE=data/local_store.json
# Local: http://localhost:5173
# Deploy: https://your-frontend-domain.com
LEXA_CORS_ORIGINS=http://localhost:5173

# Frontend deployment
# Local: http://localhost:8000
# Deploy: https://your-backend-domain.com
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
